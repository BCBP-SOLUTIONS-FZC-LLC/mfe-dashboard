    nginx["nginx :8080\n/healthz, /, remoteEntry.js"]

    host --> app
    app --> shell
    shell --> pages
    pages --> hooks
    hooks --> mocks
    app -.-> sdk
    pages -.-> sdk
    hooks -.-> sdk
    nginx --> host
