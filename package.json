{
  "name": "mfe-dashboard",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "tsc && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rsbuild build && node config/remote-manifest-entry.mjs",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage && node .github/scripts/coverage-gate.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "preview": "rsbuild preview",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@bcbp-solutions-fzc-llc/eslint-plugin": "1.0.0-alpha.5",
    "@bcbp-solutions-fzc-llc/frontend-sdk": "1.0.0-alpha.5",
    "@bcbp-solutions-fzc-llc/webpack-preset": "1.0.0-alpha.5",
    "@opentelemetry/api": "1.10.0",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.5"
  },
  "peerDependencies": {
    "@bcbp-solutions-fzc-llc/frontend-sdk": "^1.0.0-alpha.5"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
